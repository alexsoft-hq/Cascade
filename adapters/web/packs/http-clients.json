{
  "pack": "http-clients",
  "platform": [
    { "name": "fetch", "urlArg": 0, "optionsArg": 1, "methodKey": "method", "defaultMethod": "GET" },
    { "name": "xhr", "open": { "methodArg": 0, "urlArg": 1 } },
    {
      "name": "jquery",
      "why": "jQuery is loaded by a <script> tag and put on the page as a global, so no file imports it and nothing binds it. It is a platform sink for the same reason `fetch` is: the library sends the request itself and says which argument the URL is.",
      "globals": ["$", "jQuery"],
      "config": { "methods": ["ajax"], "urlArg": 0, "urlKey": "url", "methodKeys": ["type", "method"] },
      "verbs": { "get": "GET", "post": "POST", "getJSON": "GET" },
      "urlArg": 0,
      "defaultMethod": "GET"
    }
  ],
  "injected": [
    {
      "name": "$http",
      "framework": "angularjs",
      "verbs": { "get": "GET", "post": "POST", "put": "PUT", "delete": "DELETE", "patch": "PATCH", "head": "HEAD" },
      "generic": ["(call)"],
      "configUrlKey": "url",
      "configMethodKey": "method",
      "defaultMethod": "GET",
      "registrars": ["controller", "service", "factory", "provider", "directive", "component", "filter", "run", "config", "decorator"]
    }
  ],
  "libraries": [
    {
      "module": "axios",
      "instanceFactories": ["create"],
      "verbs": { "get": "GET", "post": "POST", "put": "PUT", "delete": "DELETE", "patch": "PATCH", "head": "HEAD", "options": "OPTIONS" },
      "generic": ["request", "(call)"],
      "configUrlKey": "url",
      "configMethodKey": "method",
      "configBaseUrlKey": "baseURL",
      "defaultMethod": "GET",
      "defaultsBaseUrl": "defaults.baseURL"
    },
    {
      "module": "ky",
      "instanceFactories": ["create", "extend"],
      "verbs": { "get": "GET", "post": "POST", "put": "PUT", "delete": "DELETE", "patch": "PATCH", "head": "HEAD" },
      "generic": ["(call)"],
      "configUrlKey": null,
      "configMethodKey": "method",
      "configBaseUrlKey": "prefixUrl",
      "defaultMethod": "GET"
    },
    {
      "module": "superagent",
      "verbs": { "get": "GET", "post": "POST", "put": "PUT", "delete": "DELETE", "del": "DELETE", "patch": "PATCH", "head": "HEAD" },
      "generic": [],
      "defaultMethod": "GET"
    },
    {
      "module": "@angular/common/http",
      "framework": "angular",
      "why": "Angular's HttpClient is never built by the file that uses it: a class asks for it by TYPE, as a constructor parameter or through the framework's injector, and the framework hands it an instance. So an instance is known by the type its field is declared with, and that type has to be imported from this module under one of `instanceTypes` (adapters/web/packs/injection.json says which calls declare a type). The module itself is not a client: `HttpParams` and `HttpHeaders` come from it too, and calling one of them sends nothing. `request(method, url, options)` takes its method and its URL by position, which is what `positional` says.",
      "instanceTypes": ["HttpClient"],
      "verbs": { "get": "GET", "post": "POST", "put": "PUT", "patch": "PATCH", "delete": "DELETE", "head": "HEAD", "options": "OPTIONS", "jsonp": "GET" },
      "generic": ["request"],
      "positional": { "request": { "methodArg": 0, "urlArg": 1 } },
      "defaultMethod": "GET"
    }
  ]
}
